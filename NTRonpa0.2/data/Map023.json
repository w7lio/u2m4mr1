alse,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Women","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":357,"indent":0,"parameters":["VisuMZ_2_VNPictureBusts","Basic_EnterBust","BASIC: Enter Bust",{"PictureID:eval":"50","PictureName:str":"standing images/Saya_standing_talking","Origin:str":"Bust","Position:num":"5","StartOffsetX:eval":"-200","StartOffsetY:eval":"+0","EasingType:str":"OutSine","HorzMirror:str":"Auto","Duration:eval":"20"}]},{"code":657,"indent":0,"parameters":["Picture ID = 50"]},{"code":657,"indent":0,"parameters":["Picture File = standing images/Saya_standing_talking"]},{"code":657,"indent":0,"parameters":["Origin = Bust"]},{"code":657,"indent":0,"parameters":["Screen Position = 5"]},{"code":657,"indent":0,"parameters":["Start Offset X = -200"]},{"code":657,"indent":0,"parameters":["Start Offset Y = +0"]},{"code":657,"indent":0,"parameters":["Entrance Easing = OutSine"]},{"code":657,"indent":0,"parameters":["Horizontal Mirror = Auto"]},{"code":657,"indent":0,"parameters":["Duration = 20"]},{"code":250,"indent":0,"parameters":[{"name":"sayaka/heyuhm","volume":15,"pitch":100,"pan":0}]},{"code":101,"indent":0,"parameters":["",0,1,2,"\\N[2]"]},{"code":401,"indent":0,"parameters":["「Này.. cậu là Nagi đúng không？ Là tớ \\N[2] đây. "]},{"code":401,"indent":0,"parameters":["   Cậu học chung trung học với tớ.              」"]},{"code":101,"indent":0,"parameters":["Men",0,1,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["「Tất nhiên rồi, tôi nhớ cậu. "]},{"code":401,"indent":0,"parameters":["   Thật lòng tôi không nghĩ cậu sẽ nhớ tôi.」"]},{"code":357,"indent":0,"parameters":["VisuMZ_2_VNPictureBusts","Basic_GraphicChange","BASIC: Graphic Change",{"PictureID:eval":"50","PictureName:str":"standing images/Saya_standing_blushing_talking"}]},{"code":657,"indent":0,"parameters":["Picture ID = 50"]},{"code":657,"indent":0,"parameters":["Picture F